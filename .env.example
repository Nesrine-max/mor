# Existing API mode. The frontend falls back to this value when unset.
REACT_APP_API_URL=http://localhost:5000/api

# Store display settings. These are public configuration values, not secrets.
REACT_APP_CURRENCY=USD
REACT_APP_LOCALE=en-US

