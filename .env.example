# Existing API mode. The frontend falls back to this value when unset.
REACT_APP_API_URL=http://localhost:5000/api

# Store display settings. These are public configuration values, not secrets.
REACT_APP_CURRENCY=DZD
REACT_APP_LOCALE=en-US

# Optional production data layer. When both values are present, the app uses Supabase
# instead of the legacy REACT_APP_API_URL backend.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=
